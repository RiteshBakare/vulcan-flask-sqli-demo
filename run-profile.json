{
  "language": "python",
  "build_cmd": "pip install --no-cache-dir -r requirements.txt",
  "start_cmd": "flask --app app run --host 0.0.0.0 --port 5000",
  "port": 5000,
  "health_url": "/health",
  "source": "user",
  "exploit_hints": [
    { "route": "/search", "method": "GET", "params": ["q"] }
  ],
  "snapshot_requests": [
    { "name": "health", "method": "GET", "path": "/health" },
    { "name": "users-list", "method": "GET", "path": "/users" },
    { "name": "user-1", "method": "GET", "path": "/users/1" },
    { "name": "user-missing", "method": "GET", "path": "/users/99" },
    { "name": "search-lower", "method": "GET", "path": "/search", "query": {"q": "ali"} },
    { "name": "search-upper-case", "method": "GET", "path": "/search", "query": {"q": "ALI"} },
    { "name": "search-partial", "method": "GET", "path": "/search", "query": {"q": "o"} },
    { "name": "search-no-match", "method": "GET", "path": "/search", "query": {"q": "zed"} }
  ]
}
